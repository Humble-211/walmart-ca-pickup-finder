{
  "manifest_version": 3,
  "name": "Pickup Finder (Walmart, Best Buy, Staples, Shoppers)",
  "version": "0.1.0",
  "description": "Find the nearest Walmart, Best Buy, Staples or Shoppers Drug Mart store that has an item in stock for pickup.",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": ["https://www.walmart.ca/*", "https://www.bestbuy.ca/*", "https://www.staples.ca/*", "https://api.staples.ca/*", "https://www.shoppersdrugmart.ca/*", "https://api.shoppersdrugmart.ca/*", "https://api.telegram.org/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup/popup.html", "default_title": "Pickup Finder (Walmart, Best Buy, Staples, Shoppers)" },
  "options_ui": { "page": "options/options.html", "open_in_tab": true },
  "content_scripts": [
    { "matches": ["https://www.walmart.ca/*"], "js": ["content/walmart.js"], "run_at": "document_idle" },
    { "matches": ["https://www.bestbuy.ca/*"], "js": ["content/bestbuy.js"], "run_at": "document_idle" },
    { "matches": ["https://www.staples.ca/*"], "js": ["content/staples.js"], "run_at": "document_idle" },
    { "matches": ["https://www.shoppersdrugmart.ca/*"], "js": ["content/shoppers.js"], "run_at": "document_idle" }
  ]
}
